@model CrearOrdenProduccionViewModel

@{
    ViewBag.Title = "Crear Orden de Producción";
}

<h1>FORMULARIO CREAR ORDEN DE PRODUCCIÓN</h1>

<form asp-controller="OrdenProduccion" asp-action="Crear" method="post">

    <div class="mb-3">
        <label asp-for="LaptopId" class="form-label">Crear Laptop</label>
        <select asp-for="LaptopId" class="form-select">
            <option disabled selected>Seleccione una Laptop</option>
            @foreach (var item in Model.Laptops)
            {
                <option value="@item.Id">@item.nombreLaptop</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Cantidad" class="form-label"></label>
        <input asp-for="Cantidad" class="form-control" type="number" />
    </div>

    <button type="submit" class="btn btn-primary">Crear Orden de Producción</button>
</form>
